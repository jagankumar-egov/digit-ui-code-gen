{
  "name": "Health HRMS Template",
  "description": "Health Human Resource Management System for employee/user management with boundary-based jurisdictions",
  "version": "0.0.0",
  "author": "DIGIT Team",
  "category": "human-resources",
  "config": {
    "module": {
      "name": "Health HRMS",
      "code": "health-hrms",
      "description": "Health employee management system with user creation, role assignment and jurisdiction management",
      "version": "0.0.0"
    },
    "entity": {
      "name": "HRMS",
      "apiPath": "/health-hrms",
      "primaryKey": "code",
      "displayField": "user.name"
    },
    "screens": {
      "create": {
        "enabled": true,
        "roles": ["HRMS_ADMIN", "SYSTEM_ADMINISTRATOR"],
        "sections": [
          {
            "head": "Login Details",
            "i18nKey": "HR_LOGIN_DETAILS_HEADER",
            "fields": ["username", "password", "confirmPassword"]
          },
          {
            "head": "Personal Details",
            "i18nKey": "HR_PERSONAL_DETAILS_HEADER",
            "fields": ["employeeName", "mobileNumber", "gender", "dateOfBirth", "emailId", "correspondenceAddress"]
          },
          {
            "head": "Employment Details",
            "i18nKey": "HR_NEW_EMPLOYEE_FORM_HEADER",
            "fields": ["employeeType", "dateOfAppointment", "department", "designation", "roles"]
          }
        ]
      },
      "search": {
        "enabled": true,
        "roles": ["HRMS_ADMIN", "SYSTEM_ADMINISTRATOR"],
        "minSearchFields": 0,
        "showFooter": true
      },
      "inbox": {
        "enabled": false
      },
      "view": {
        "enabled": true,
        "roles": ["HRMS_ADMIN", "SYSTEM_ADMINISTRATOR"],
        "sections": ["personal", "employment", "jurisdictions"]
      },
      "response": {
        "enabled": true
      }
    },
    "fields": [
      {
        "name": "username",
        "type": "text",
        "label": "Username",
        "required": true,
        "searchable": true,
        "showInResults": true,
        "showInInboxResults": true,
        "showInView": true,
        "validation": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 50
        }
      },
      {
        "name": "password",
        "type": "password",
        "label": "Password",
        "required": true,
        "showInView": false,
        "validation": {
          "pattern": "(?=.*\\\\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[@#$%])(?=\\\\S+$).{8,15}",
          "minLength": 8,
          "maxLength": 15
        }
      },
      {
        "name": "confirmPassword",
        "type": "password",
        "label": "Confirm Password",
        "required": true,
        "showInView": false,
        "validation": {
          "minLength": 8,
          "maxLength": 15
        }
      },
      {
        "name": "employeeName",
        "type": "text",
        "label": "Name",
        "required": true,
        "searchable": true,
        "showInResults": true,
        "showInInboxResults": true,
        "showInView": true,
        "validation": {
          "pattern": "^[A-Za-z\\s.'-]{1,50}$",
          "maxLength": 50
        }
      },
      {
        "name": "mobileNumber",
        "type": "mobileNumber",
        "label": "Mobile Number",
        "required": true,
        "searchable": true,
        "showInResults": false,
        "showInView": true,
        "validation": {
          "minLength": 10,
          "maxLength": 10,
          "min": 6000000000,
          "max": 9999999999
        }
      },
      {
        "name": "gender",
        "type": "radio",
        "label": "Gender",
        "required": true,
        "showInView": true,
        "mdms": {
          "masterName": "GenderType",
          "moduleName": "common-masters",
          "localePrefix": "COMMON_GENDER"
        }
      },
      {
        "name": "dateOfBirth",
        "type": "date",
        "label": "Date of Birth",
        "required": true,
        "showInView": true
      },
      {
        "name": "emailId",
        "type": "text",
        "label": "Email",
        "required": false,
        "showInView": true,
        "validation": {
          "pattern": "^[\\w-.]+@([\\w-]+\\.)+[\\w-]{2,4}$"
        }
      },
      {
        "name": "correspondenceAddress",
        "type": "text",
        "label": "Correspondence Address",
        "required": false,
        "showInView": true
      },
      {
        "name": "employeeType",
        "type": "dropdown",
        "label": "Employment Type",
        "required": true,
        "showInView": true,
        "mdms": {
          "masterName": "EmployeeType",
          "moduleName": "egov-hrms",
          "localePrefix": "EGOV_HRMS_EMPLOYEETYPE"
        }
      },
      {
        "name": "dateOfAppointment",
        "type": "date",
        "label": "Date of Appointment",
        "required": true,
        "showInView": true
      },
      {
        "name": "department",
        "type": "dropdown",
        "label": "Department",
        "required": true,
        "showInView": true,
        "showInInboxResults": true,
        "mdms": {
          "masterName": "Department",
          "moduleName": "common-masters",
          "localePrefix": "COMMON_MASTERS_DEPARTMENT"
        }
      },
      {
        "name": "designation",
        "type": "dropdown",
        "label": "Designation",
        "required": true,
        "showInView": true,
        "showInInboxResults": true,
        "mdms": {
          "masterName": "Designation",
          "moduleName": "common-masters",
          "localePrefix": "COMMON_MASTERS_DESIGNATION"
        }
      },
      {
        "name": "roles",
        "type": "multiselectdropdown",
        "label": "Roles",
        "required": true,
        "showInResults": true,
        "showInInboxResults": true,
        "showInView": true,
        "mdms": {
          "masterName": "roles",
          "moduleName": "ACCESSCONTROL-ROLES",
          "localePrefix": "ACCESSCONTROL_ROLES_ROLES"
        }
      },
      {
        "name": "employeeStatus",
        "type": "radio",
        "label": "Employment Status",
        "required": false,
        "filterable": true,
        "showInView": true,
        "options": [
          { "code": "true", "name": "Active" },
          { "code": "false", "name": "Deactivated" }
        ]
      }
    ],
    "api": {
      "create": "/health-hrms/employees/_create",
      "update": "/health-hrms/employees/_update",
      "search": "/health-hrms/employees/_search"
    },
    "auth": {
      "required": true,
      "roles": ["HRMS_ADMIN", "SYSTEM_ADMINISTRATOR"]
    },
    "workflow": {
      "enabled": false
    },
    "i18n": {
      "prefix": "HR_",
      "generateKeys": true
    },
    "inboxSearch": {
      "searchFields": ["employeeName", "username", "mobileNumber"],
      "filterFields": ["roles", "employeeStatus"],
      "resultColumns": ["username", "employeeName", "roles", "designation", "department"],
      "sortBy": "lastModifiedTime",
      "sortOrder": "DESC",
      "limit": 10,
      "links": [
        {
          "label": "Create User",
          "i18nKey": "HR_COMMON_CREATE_EMPLOYEE_HEADER",
          "url": "/employee/health-hrms/create",
          "roles": ["SYSTEM_ADMINISTRATOR", "HRMS_ADMIN"]
        }
      ]
    }
  }
}
